# Neo4j Aura credentials — only needed for the vector and lexical arms.
# The static arm and all non-integration tests run without Neo4j; leave these unset for it.
# Note: Aura sometimes sets both NEO4J_USERNAME and NEO4J_DATABASE to the instance ID
# (e.g. "da1cbf58"). If you get auth or "database does not exist" errors, try "neo4j" for both.
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-password>
NEO4J_DATABASE=neo4j

# LLM provider — "openai" (default) or "anthropic"
# Reported runs used gpt-4o as resolved on 2026-08-02; pin to that dated snapshot
# (e.g. LLM_MODEL=gpt-4o-YYYY-MM-DD) for exact replication — "gpt-4o" is a mutable alias.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-...

# Embedding model for the Neo4j vector indexes (vector + lexical arms)
EMBEDDING_MODEL=text-embedding-3-small

# Uncomment if using Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...
